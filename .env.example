# Google OAuth credentials for local builds.
#
# Copy this file to `.env` and fill in the publisher's OAuth client values.
# `.env` is git-ignored and must never be committed.
# `src-tauri/build.rs` embeds the values into release builds.

BN_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
BN_GOOGLE_CLIENT_SECRET=your-oauth-client-secret
